#include <stdio.h>

int linear_search(const int a[], int n, int key, int *steps)
{
    *steps = 0;

    for (int i = 0; i < n; i++) {
        (*steps)++;

        if (a[i] == key)
            return i;
    }

    return -1;
}

int binary_search(const int a[], int n, int key, int *steps)
{
    int low = 0, high = n - 1;
    *steps = 0;

    while (low <= high) {
        int mid = low + (high - low) / 2;
        (*steps)++;

        if (a[mid] == key)
            return mid;
        else if (a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

int main(void)
{
    int books[] = {
        1021, 1048, 1103, 1190, 1222,
        1305, 1377, 1402, 1460, 1533
    };

    int n = sizeof(books) / sizeof(books[0]);
    int keys[] = {1021, 1305, 1533, 1400};

    printf("LIBRARY SEARCH SYSTEM\n");

    for (int i = 0; i < 4; i++) {
        int steps, pos;

        pos = binary_search(books, n, keys[i], &steps);

        printf("Book %d -> index %d, comparisons = %d\n",
               keys[i], pos, steps);
    }

    return 0;
}

/* Output:
LIBRARY SEARCH SYSTEM
Book 1021 -> index 0, comparisons = 3
Book 1305 -> index 5, comparisons = 3
Book 1533 -> index 9, comparisons = 3
Book 1400 -> index -1, comparisons = 5
