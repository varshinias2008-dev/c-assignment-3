#include <stdio.h>
#include <string.h>

#define MAX 500
#define LEN 30

void sort_names(char names[MAX][LEN], int n)
{
    char temp[LEN];

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (strcmp(names[j], names[j + 1]) > 0) {
                strcpy(temp, names[j]);
                strcpy(names[j], names[j + 1]);
                strcpy(names[j + 1], temp);
            }
        }
    }
}

int binary_search(char names[MAX][LEN],
                  int n, const char key[])
{
    int low = 0;
    int high = n - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;
        int result = strcmp(names[mid], key);

        if (result == 0)
            return mid;
        else if (result < 0)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

void display_duplicates(char names[MAX][LEN], int n)
{
    int found = 0;

    printf("\nDUPLICATE NAMES:\n");

    for (int i = 1; i < n; i++) {
        if (strcmp(names[i], names[i - 1]) == 0) {
            if (i == 1 ||
                strcmp(names[i], names[i - 2]) != 0) {
                printf("%s\n", names[i]);
                found = 1;
            }
        }
    }

    if (!found)
        printf("No duplicate names found.\n");
}

int main(void)
{
    char names[MAX][LEN];
    char key[LEN];
    int n;

    printf("Enter number of residents (1-%d): ", MAX);

    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Invalid number of residents.\n");
        return 1;
    }

    getchar();

    for (int i = 0; i < n; i++) {
        printf("Enter resident %d name: ", i + 1);

        if (fgets(names[i], LEN, stdin) == NULL)
            return 1;

        names[i][strcspn(names[i], "\n")] = '\0';
    }

    sort_names(names, n);

    printf("\nALPHABETICAL DIRECTORY:\n");

    for (int i = 0; i < n; i++)
        printf("%s\n", names[i]);

    display_duplicates(names, n);

    printf("\nEnter name to search: ");

    if (fgets(key, LEN, stdin) == NULL)
        return 1;

    key[strcspn(key, "\n")] = '\0';

    int pos = binary_search(names, n, key);

    if (pos != -1)
        printf("%s found at position %d\n", key, pos + 1);
    else
        printf("%s not found.\n", key);

    return 0;
}
